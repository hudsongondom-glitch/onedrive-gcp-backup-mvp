# Server
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Microsoft Graph / OAuth 2.0
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MS_OAUTH_SCOPES=offline_access User.Read Files.Read Files.Read.All

# Google Cloud Storage
GCS_BUCKET_NAME=onedrive-backup-mvp-storage-hudsong
GCP_PROJECT_ID=

# Firestore
FIRESTORE_PROJECT_ID=

# Google Cloud credentials
# In Cloud Run this is provided by the runtime service account.
# Locally, point to a service account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=
